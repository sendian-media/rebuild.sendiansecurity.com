---
import BaseLayout from '../layouts/BaseLayout.astro';
import Metrics from '../components/home/Metrics.astro';
import PageHero from '../components/layout/PageHero.astro';
import { services } from '@/data/services';

const { hero, intro, bands, stats } = services;
// One local image per service card; sources are documented in docs/research/convergint-com-services/references.md.
const cardImages: Record<string, string> = {
  'CCTV Surveillance': '/images/services/security-solutions.png',
  'Access Control Solutions': '/images/services/access-control-reader.jpeg',
  'Cyber Security Solutions': '/images/services/cyber-security-screen.jpeg',
  'Structured Cabling System': '/images/services/infrastructure-solutions.png',
  'Data Center Solution': '/images/services/data-center-racks.jpeg',
  'Storage Solution': '/images/services/storage-array.jpeg',
  'Parking Management Systems': '/images/services/parking-management-entry.jpeg',
  'Parking Guidance Systems': '/images/services/parking-guidance-arrows.jpeg',
  'LPR Solutions': '/images/services/parking-systems.jpeg',
  'Unified Communication': '/images/services/unified-communications-phone.jpeg',
  'Enterprise Network Solutions': '/images/services/enterprise-network-switch.jpeg',
  'Home Automation Systems': '/images/services/home-automation-control.jpeg',
  'Audio Visual Systems': '/images/services/audio-visual-microphone.jpeg',
  'Video Solutions': '/images/services/video-solutions-conference.jpeg',
  'Annual Maintenance Contracts': '/images/services/other-solutions.png',
  'Intercom System': '/images/services/intercom-system.jpeg',
  'Smart WiFi Solution': '/images/services/wifi-router.jpeg',
  'Cloud Solutions': '/images/services/cloud-solutions.jpeg',
};
---

<BaseLayout title="Services — Sendian Security" description="Integrated security, infrastructure, parking, communication, audio-visual and maintenance solutions from SISS, an MOI-approved provider in Qatar." socialImage={hero.image} bodyClass="page-services">
  <PageHero crumb="Services" title={hero.title} sub={hero.description} />

  <section class="sv-intro">
    <div class="container sv-intro-grid">
      <p class="eyebrow">{intro.eyebrow}</p>
      <div>
        <h2>{intro.heading}</h2>
        <p class="sv-intro-desc">{intro.description}</p>
      </div>
    </div>
  </section>

  {bands.map((band) => (
    <section class:list={['sv-band', { 'sv-band-dark': band.theme === 'dark' }]}>
      <div class="container sv-band-grid">
        <div class="sv-band-head">
          <p class="eyebrow">{band.eyebrow}</p>
          <h2>{band.heading}</h2>
          <p class="sv-band-desc">{band.description}</p>
        </div>
        <div class="sv-cards">
          {band.items.map((item) => (
            <article class="sv-card">
              <img class="sv-card-image" src={cardImages[item.title]} alt="" width="1408" height="768" loading="lazy" />
              <div class="sv-card-content">
                <h3>{item.title}</h3>
                <p class="sv-card-desc">{item.description}</p>
                <a class="sv-card-link" href="/#contact">Learn more <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <Metrics metrics={stats} />
</BaseLayout>
