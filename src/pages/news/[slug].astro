---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsDetail from '@/components/sites/sendian-news/NewsDetail.astro';
import { getNews } from '@/lib/cms';
const { news, articles } = await getNews();

const item = news.find((entry) => entry.slug === Astro.params.slug);
if (!item || !articles[item.slug]) return Astro.redirect('/404');
---

<BaseLayout title={`${item.title} — Sendian Security`} description={articles[item.slug].summary} socialImage={item.image} article={{ headline: item.title, datePublished: new Date(`${item.date} UTC`).toISOString().slice(0, 10) }} bodyClass="page-news-detail">
  <NewsDetail item={item} article={articles[item.slug]} news={news} />
</BaseLayout>
