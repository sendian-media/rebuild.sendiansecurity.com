---
import { home } from '@/data/home';
import '@/styles/process-carousel.css';

const icons = [
  'M8 10h8M8 14h5M7 3h10a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3h-5l-5 3v-3a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Z',
  'm4 16 12-12 4 4L8 20H4v-4Zm9-9 4 4M4 4h4M4 4v4M16 20h4v-4',
  'm12 3 9 5-9 5-9-5 9-5ZM3 12l9 5 9-5M3 16l9 5 9-5',
  'm8 12 3 3 5-6M12 3l8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z',
  'M4 12a8 8 0 0 1 14-5l2 2M20 4v5h-5M20 12a8 8 0 0 1-14 5l-2-2M4 20v-5h5',
];
---

<section class="process" aria-labelledby="process-title" aria-roledescription="carousel" data-process-carousel>
  <div class="container">
    <div class="process-header">
      <div>
        <p class="eyebrow eyebrow-light">How we work</p>
        <h2 id="process-title">Consult → Design → Deploy<br />→ Commission → Maintain.</h2>
      </div>
      <div class="process-controls" hidden data-process-controls>
        <button type="button" aria-label="Previous process step" aria-controls="process-track" aria-disabled="true" data-process-prev>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h13" /></svg>
        </button>
        <button type="button" aria-label="Next process step" aria-controls="process-track" data-process-next>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m10 6 6 6-6 6M16 12H3" /></svg>
        </button>
      </div>
    </div>
    <div class="process-track" id="process-track" tabindex="0" role="group" aria-label="Process steps. Scroll to explore all five steps." data-process-track>
      {home.steps.map((step, index) => (
        <article class="process-card" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${home.steps.length}: ${step.title}`} data-process-card data-current={index === 0 ? 'true' : undefined}>
          <div class="process-card-top">
            <span class="process-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="process-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={icons[index]} /></svg></span>
          </div>
          <div class="process-card-copy"><h3>{step.title}</h3><p>{step.description}</p></div>
          <div class="process-card-foot" aria-hidden="true"><span>Step {String(index + 1).padStart(2, '0')}</span><span>↗</span></div>
        </article>
      ))}
    </div>
    <div class="process-footer" hidden data-process-footer>
      <p class="process-count" role="status" aria-atomic="true" data-process-count></p>
      <div class="process-progress" aria-hidden="true"><span data-process-progress></span></div>
      <span class="process-total" aria-hidden="true">05</span>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-process-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-process-track]')!;
    const cards = Array.from(carousel.querySelectorAll<HTMLElement>('[data-process-card]'));
    const previous = carousel.querySelector<HTMLButtonElement>('[data-process-prev]')!;
    const next = carousel.querySelector<HTMLButtonElement>('[data-process-next]')!;
    const count = carousel.querySelector<HTMLElement>('[data-process-count]')!;
    const progress = carousel.querySelector<HTMLElement>('[data-process-progress]')!;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    function sync() {
      const bounds = track.getBoundingClientRect();
      const visible = cards.map((card, index) => ({ index, bounds: card.getBoundingClientRect() }))
        .filter((card) => Math.min(card.bounds.right, bounds.right) - Math.max(card.bounds.left, bounds.left) >= Math.min(card.bounds.width, bounds.width) / 2);
      if (!visible.length) return;
      const first = visible[0].index;
      const last = visible[visible.length - 1].index;
      const range = first === last ? `Step ${String(first + 1).padStart(2, '0')}` : `Steps ${String(first + 1).padStart(2, '0')}–${String(last + 1).padStart(2, '0')}`;
      const label = `${range} of ${String(cards.length).padStart(2, '0')}`;
      if (count.textContent !== label) count.textContent = label;
      cards.forEach((card, index) => card.toggleAttribute('data-current', index === first));
      previous.setAttribute('aria-disabled', String(track.scrollLeft <= 2));
      next.setAttribute('aria-disabled', String(track.scrollLeft >= track.scrollWidth - track.clientWidth - 2));
      progress.style.width = `${((last + 1) / cards.length) * 100}%`;
    }

    function move(direction: number) {
      const stride = cards[1].offsetLeft - cards[0].offsetLeft;
      track.scrollBy({ left: direction * stride, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
    }

    previous.addEventListener('click', () => { if (previous.getAttribute('aria-disabled') !== 'true') move(-1); });
    next.addEventListener('click', () => { if (next.getAttribute('aria-disabled') !== 'true') move(1); });
    track.addEventListener('keydown', (event) => {
      if (event.target !== track) return;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        move(event.key === 'ArrowRight' ? 1 : -1);
      } else if (event.key === 'Home' || event.key === 'End') {
        event.preventDefault();
        track.scrollTo({ left: event.key === 'Home' ? 0 : track.scrollWidth, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
      }
    });
    let timer: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', () => { clearTimeout(timer); timer = setTimeout(sync, 120); }, { passive: true });
    new ResizeObserver(sync).observe(track);
    carousel.querySelector<HTMLElement>('[data-process-controls]')!.hidden = false;
    carousel.querySelector<HTMLElement>('[data-process-footer]')!.hidden = false;
    sync();
  });
</script>
