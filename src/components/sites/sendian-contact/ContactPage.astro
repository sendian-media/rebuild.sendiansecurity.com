---
import { site } from '@/data/site';
---

<section class="contact-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Contact</span></nav>
    <p class="eyebrow">Get in touch</p>
    <h1>Let’s start a<br />conversation.</h1>
    <p class="hero-intro">Whether you have a project in mind or a question for our team, we’re here to help.</p>
  </div>
</section>

<section class="contact-content">
  <div class="container contact-grid">
    <div class="contact-details">
      <p class="eyebrow">Contact us</p>
      <h2>Talk to our team.</h2>
      <p class="intro">Tell us what you need. We’ll help you find the right integrated solution for your project.</p>
      <div class="details-list">
        <div><h3>Call us</h3><p>{site.phone}<br />+974 74720643</p></div>
        <div><h3>Email us</h3><p>{site.email}</p></div>
        <div><h3>Visit our head office</h3><p>{site.address[0]}<br />{site.address[1]}</p></div>
      </div>
    </div>
    <div class="enquiry">
      <p class="eyebrow">Your enquiry</p>
      <h2>Send a message.</h2>
      <p class="form-note" id="form-note">This enquiry form is a local preview and cannot send messages.</p>
      <fieldset disabled aria-describedby="form-note">
        <div class="form-grid">
          <label>Full name <input type="text" name="name" autocomplete="name" /></label>
          <label>Phone number <input type="tel" name="phone" autocomplete="tel" /></label>
          <label>Email address <input type="email" name="email" autocomplete="email" /></label>
          <label>How can we help?
            <select name="service"><option>Select a service</option><option>Security and surveillance</option><option>Infrastructure and data systems</option><option>Networks and communication</option><option>Other enquiry</option></select>
          </label>
          <label class="wide">Your message <textarea name="message" rows="5"></textarea></label>
        </div>
        <button class="send-button" type="button">Send enquiry <span aria-hidden="true">→</span></button>
      </fieldset>
    </div>
  </div>
</section>

<section class="location">
  <div class="container location-grid">
    <div>
      <p class="eyebrow">Our location</p>
      <h2>Visit our head office.</h2>
      <p>{site.address[0]}<br />{site.address[1]}</p>
    </div>
    <iframe title="Sendian Integrated Security Services head office location" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3606.724560941799!2d51.463750176021286!3d25.313456626980738!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3e45db0c32c1d90f%3A0x8879e436e11ea0f0!2sSendian%20Integrated%20Security%20Services%20-%20SISS!5e0!3m2!1sen!2sqa!4v1791713035845!5m2!1sen!2sqa" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
  </div>
</section>

<style>
  .contact-hero{background:var(--navy);color:white;padding:42px 0 96px;position:relative;overflow:hidden}
  .contact-hero::after{content:'';position:absolute;inset:0 0 0 55%;pointer-events:none;background:linear-gradient(115deg,transparent,rgba(35,63,144,.45)),repeating-linear-gradient(90deg,transparent 0 79px,rgba(255,255,255,.035) 80px),repeating-linear-gradient(0deg,transparent 0 79px,rgba(255,255,255,.035) 80px)}
  .contact-hero .container{position:relative;z-index:1}
  .breadcrumb{display:flex;gap:8px;color:#c3cedd;font-size:13px}
  .breadcrumb a:hover{text-decoration:underline}
  .contact-hero .eyebrow{color:#80a9d0;margin-top:62px}
  h1{font-size:clamp(42px,5vw,68px);line-height:1.1;letter-spacing:-.03em;margin-top:18px}
  .hero-intro{max-width:550px;margin-top:24px;color:#c3cedd;font-size:18px;line-height:1.6}
  .contact-content{background:#f4f7fb;padding:96px 0 112px}
  .contact-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(48px,8vw,120px);align-items:start}
  .contact-details h2,.enquiry h2{font-size:clamp(30px,3vw,40px);margin-top:16px}
  .intro{color:var(--muted);font-size:17px;line-height:1.65;margin-top:22px;max-width:420px}
  .details-list{display:grid;gap:28px;margin-top:48px}
  .details-list>div{border-top:1px solid #d9e1eb;padding-top:20px}
  .details-list h3{font-size:13px;color:var(--blue);text-transform:uppercase;letter-spacing:.1em}
  .details-list p{margin-top:9px;line-height:1.6;overflow-wrap:anywhere}
  .enquiry{background:white;padding:clamp(28px,4vw,52px);box-shadow:0 12px 40px rgba(7,22,41,.06)}
  .form-note{color:var(--muted);font-size:14px;line-height:1.5;margin-top:16px}
  fieldset{border:0;margin:32px 0 0;padding:0;min-width:0}
  .form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}
  label{display:grid;gap:9px;font:600 13px/1.5 Montserrat,Arial,sans-serif;color:var(--ink)}
  input,select,textarea{width:100%;min-width:0;border:1px solid #ced8e5;background:#f8fafc;color:#526176;border-radius:0;padding:13px;font:400 16px/1.4 Roboto,Arial,sans-serif;opacity:1}
  input,select{min-height:50px} textarea{resize:vertical}.wide{grid-column:1/-1}
  .send-button{display:inline-flex;align-items:center;gap:24px;margin-top:28px;min-height:50px;padding:0 22px;background:var(--blue);color:white;font:600 13px Montserrat,Arial,sans-serif;opacity:.6;cursor:not-allowed}
  .location{padding:96px 0;background:#fff}
  .location-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(48px,8vw,120px);align-items:center}
  .location h2{font-size:clamp(30px,3vw,40px);margin-top:16px}
  .location p:not(.eyebrow){margin-top:22px;color:var(--muted);line-height:1.65}
  .location iframe{width:100%;height:400px;border:0}
  @media(max-width:800px){.location{padding:64px 0}.location-grid{grid-template-columns:1fr;gap:32px}.location iframe{height:320px}.contact-hero{padding:32px 0 64px}.contact-hero .eyebrow{margin-top:48px}.contact-content{padding:64px 0}.contact-grid{grid-template-columns:1fr;gap:48px}}
  @media(max-width:480px){.contact-hero::after{inset-inline-start:25%}.form-grid{grid-template-columns:1fr}.wide{grid-column:auto}.enquiry{padding:24px}.hero-intro{font-size:16px}}
</style>
