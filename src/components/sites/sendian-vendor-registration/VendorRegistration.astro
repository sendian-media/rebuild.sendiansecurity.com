---
import { getSite } from '@/lib/cms';
const site = await getSite();
import { formsEnabled } from '@/lib/forms';
const enabled = formsEnabled();
---
<section class="vendor-section">
  <div class="container vendor-grid">
    <div>
      <p class="eyebrow">Partner with SISS</p>
      <h2>Become a partner. Join our vendor network.</h2>
      <p class="intro">We are looking for qualified vendors, suppliers, and contractors to join our network. Register today to explore partnership opportunities with Qatar's leading MOI-approved security solutions provider.</p>
      <h3>Head office</h3>
      <p class="office">{site.address[0]}<br />{site.address[1]}<br /><a href={site.phoneHref}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div class="vendor-card">
      <p class="eyebrow">Vendor registration</p>
      <h2>Register your company.</h2>
      <p id="vendor-notice">{enabled ? "All fields are required." : "This registration form is a local preview and cannot submit information."}</p>
      <form method="post" action="/api/forms" data-sendian-form aria-describedby="vendor-notice">
      <input type="hidden" name="form" value="vendor" />
      <label class="honeypot" aria-hidden="true">Leave empty <input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      <fieldset disabled={!enabled}>
        <div class="fields">
          <label class="wide">Full name <input type="text" name="name" maxlength="400" required autocomplete="name" /></label>
          <label>Email address <input type="email" name="email" maxlength="254" required autocomplete="email" /></label>
          <label>Phone number <input type="tel" name="phone" maxlength="400" required autocomplete="tel" /></label>
          <label class="wide">Company name <input type="text" name="company" maxlength="400" required autocomplete="organization" /></label>
          <label class="wide">Company type <select name="company-type" required><option value="">Select company type</option><option>Supplier</option><option>Contractor</option><option>Service provider</option><option>Manufacturer</option><option>Distributor</option><option>Other</option></select></label>
          <label class="wide">Products or services category <select name="category" required><option value="">Select a category</option><option>CCTV and surveillance systems</option><option>Access control systems</option><option>Fire detection and alarms</option><option>Networking and IT infrastructure</option><option>ELV systems</option><option>Installation services</option><option>Maintenance services</option><option>Hardware and equipment</option><option>Software solutions</option><option>Other</option></select></label>
          <label class="wide">Company overview <textarea name="overview" rows="4" maxlength="2000" required></textarea></label>
          <label class="consent wide"><input type="checkbox" name="consent" required /> I agree to be contacted by SISS regarding vendor partnership opportunities.</label>
        </div>
        <button type="submit">Submit registration <span aria-hidden="true">→</span></button>
      </fieldset>
      <p id="vendor-status" data-form-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>
<style>
  .vendor-section{background:#f4f7fb;padding:96px 0 112px}
  .vendor-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(48px,8vw,120px);align-items:start}
  h2{font-size:clamp(30px,3vw,40px);line-height:1.2;margin-top:16px}
  .intro,.office{color:var(--muted);line-height:1.65;margin-top:22px}
  h3{font-size:18px;margin-top:42px}.office a{text-decoration:underline}
  .vendor-card{background:white;padding:clamp(28px,4vw,52px);box-shadow:0 12px 40px rgba(7,22,41,.06)}
  #vendor-notice{color:var(--muted);font-size:14px;line-height:1.5;margin-top:16px}
  fieldset{border:0;margin:32px 0 0;padding:0;min-width:0}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}
  label{display:grid;gap:9px;font:600 13px/1.5 Montserrat,Arial,sans-serif;color:var(--ink)}
  input:not([type="checkbox"]),select,textarea{width:100%;min-width:0;border:1px solid #ced8e5;background:#f8fafc;color:#526176;padding:13px;font:400 16px/1.4 Roboto,Arial,sans-serif;opacity:1}
  input:not([type="checkbox"]),select{min-height:50px}textarea{resize:vertical}.wide{grid-column:1/-1}.consent{display:flex;align-items:start;gap:10px}.consent input{margin-top:3px}
  .honeypot{position:absolute;left:-10000px}
  button{margin-top:28px;min-height:50px;padding:0 22px;background:var(--blue);color:white;font:600 13px Montserrat,Arial,sans-serif;}button:disabled{opacity:.6;cursor:not-allowed}
  @media(max-width:800px){.vendor-section{padding:64px 0}.vendor-grid{grid-template-columns:1fr;gap:48px}}
  @media(max-width:480px){.fields{grid-template-columns:1fr}.wide{grid-column:auto}.vendor-card{padding:24px}}
</style>
